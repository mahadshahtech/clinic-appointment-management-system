# Web (safe for browser exposure)
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# API (server only)
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Required only for privileged account tooling/admin workflows.
SUPABASE_SECRET_KEY=sb_secret_replace_me
EMAIL_DELIVERY_MODE=console
N8N_EMAIL_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_POLL_INTERVAL_MS=60000
AUTOMATION_BATCH_SIZE=25
AUTOMATION_RUN_ONCE=false

# Database (server only; never expose through VITE_ variables)
# Put real database credentials only in .env — NEVER in this example file.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Optional disposable database used only for destructive integration tests.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Required in addition to TEST_DATABASE_URL before destructive database tests can run.
RUN_DATABASE_TESTS=false
